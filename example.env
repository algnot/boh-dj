# App URL (used by LINE bot + LIFF endpoint base)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional fallback name for the publishable/anon key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LINE Messaging API
# Create a Messaging API channel at https://developers.line.biz/
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token

# LINE add-friend URL (หน้าแรกใช้ลิงก์นี้)
# ดูได้จาก LINE OA → เพิ่มเพื่อน เช่น https://line.me/R/ti/p/@yourid หรือ https://lin.ee/xxxx
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@yourid

# LINE LIFF (LINE Login channel → LIFF)
# Endpoint URL ต้องเป็น: {NEXT_PUBLIC_APP_URL}/liff
# เช่น https://internal.tongla.dev/liff
# Size: Full / Tall, Scopes: profile, openid
NEXT_PUBLIC_LIFF_ID=your_liff_id

# Optional: YouTube Data API key
# ใช้ดึงเพลงแรกจากเพลลิสต์ได้ชัวร์ขึ้น (ไม่มีก็ใช้ Atom feed ได้)
# YOUTUBE_API_KEY=
